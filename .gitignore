# Rust build artifacts
/target/
**/*.rs.bk
*.pdb

# Release archives & packages (prevent accidental staging of local release builds)
*.zip
*.tar.gz
*.deb
*.dmg
*.pkg

# Executables & dynamic libraries (prevent accidental commit of local binaries outside target/)
*.exe
*.dll
*.so
*.dylib

# WebAssembly & Trunk artifacts
/dist/
/.trunk/

# Linux packaging artifacts
/deb_pkg/

# Generated Windows ICO (rebuilt automatically from assets/icon.jpeg by build.rs)
/assets/icon.ico

# Local fallback settings file (if run without APPDATA)
quadfurn_settings.json

# Environment files, secrets & logs
.env
.env.*
*.log
*.pem
*.key

# IDE, Editor & Tooling directories
.idea/
.vscode/
.gemini/
*.swp
*.swo
*~
*.tmp
*.bak
*.orig

# OS metadata
.DS_Store
Thumbs.db
desktop.ini
